#!/bin/bash
# =============================================================================
# WORKER bootstrap (Amazon Linux 2023, arm64).
# Runs once at first boot:
#   prereqs -> poll SSM for the join command -> kubeadm join
#
# No custom hostname: workers in an ASG keep their unique default AWS hostname.
#
# Template variables (filled by Terraform templatefile()):
#   ${kubernetes_version}        e.g. 1.36
#   ${region}                    e.g. eu-west-1
#   ${join_command_param_name}   e.g. /learn-k8s/join-command
#
# Logs: /var/log/cloud-init-output.log
# =============================================================================
set -euxo pipefail

# ---- 1. Kernel modules -----------------------------------------------------
cat <<'EOF' >/etc/modules-load.d/k8s.conf
overlay
br_netfilter
EOF
modprobe overlay
modprobe br_netfilter

# ---- 2. sysctl -------------------------------------------------------------
cat <<'EOF' >/etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF
sysctl --system

# ---- 3. Disable swap -------------------------------------------------------
swapoff -a || true
sed -i '/ swap / s/^/#/' /etc/fstab || true

# ---- 4. containerd ---------------------------------------------------------
dnf install -y containerd
mkdir -p /etc/containerd
containerd config default >/etc/containerd/config.toml
sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
systemctl enable --now containerd
systemctl restart containerd

# ---- 5. Kubernetes packages ------------------------------------------------
cat <<EOF >/etc/yum.repos.d/kubernetes.repo
[kubernetes]
name=Kubernetes
baseurl=https://pkgs.k8s.io/core:/stable:/v${kubernetes_version}/rpm/
enabled=1
gpgcheck=1
gpgkey=https://pkgs.k8s.io/core:/stable:/v${kubernetes_version}/rpm/repodata/repomd.xml.key
exclude=kubelet kubeadm kubectl cri-tools kubernetes-cni
EOF
dnf install -y kubelet kubeadm kubectl --disableexcludes=kubernetes
systemctl enable --now kubelet

# ---- 6. Poll SSM for the join command --------------------------------------
# The control plane publishes the join command to this parameter after it
# finishes `kubeadm init`. We boot in parallel with it, so poll until ready.
# Bounded to 60 tries x 15s = ~15 min, then fail loudly.
JOIN_CMD="pending"
for i in $(seq 1 60); do
  JOIN_CMD=$(aws ssm get-parameter \
    --name "${join_command_param_name}" \
    --region ${region} \
    --query "Parameter.Value" \
    --output text 2>/dev/null || echo "pending")

  if [ "$JOIN_CMD" != "pending" ] && [ -n "$JOIN_CMD" ]; then
    echo "join command retrieved after $i attempt(s)"
    break
  fi

  echo "join command not ready yet (attempt $i/60), waiting 15s..."
  sleep 15
done

if [ "$JOIN_CMD" = "pending" ] || [ -z "$JOIN_CMD" ]; then
  echo "ERROR: join command never became available; giving up" >&2
  exit 1
fi

# ---- 7. Join the cluster ---------------------------------------------------
eval "$JOIN_CMD"

echo "worker bootstrap complete (k8s v${kubernetes_version})"
